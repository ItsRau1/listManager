<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema Claro - Material 3, seed verde -->
    <style name="Theme.ListManager.Light" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/md_light_primary</item>
        <item name="colorOnPrimary">@color/md_light_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_light_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_light_on_primary_container</item>

        <item name="colorSecondary">@color/md_light_secondary</item>
        <item name="colorOnSecondary">@color/md_light_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_light_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_light_on_secondary_container</item>

        <item name="colorTertiary">@color/md_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_light_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_light_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_light_on_tertiary_container</item>

        <item name="colorError">@color/md_light_error</item>
        <item name="colorOnError">@color/md_light_on_error</item>
        <item name="colorErrorContainer">@color/md_light_error_container</item>
        <item name="colorOnErrorContainer">@color/md_light_on_error_container</item>

        <item name="android:colorBackground">@color/md_light_background</item>
        <item name="colorOnBackground">@color/md_light_on_background</item>
        <item name="colorSurface">@color/md_light_surface</item>
        <item name="colorOnSurface">@color/md_light_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_light_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_light_on_surface_variant</item>
        <item name="colorOutline">@color/md_light_outline</item>
        <item name="colorOutlineVariant">@color/md_light_outline_variant</item>

        <item name="android:statusBarColor">@color/md_light_surface</item>
        <item name="android:navigationBarColor">@color/md_light_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Tema Escuro - Material 3, seed verde -->
    <style name="Theme.ListManager.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/md_dark_primary</item>
        <item name="colorOnPrimary">@color/md_dark_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_dark_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_dark_on_primary_container</item>

        <item name="colorSecondary">@color/md_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_dark_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_dark_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_dark_on_secondary_container</item>

        <item name="colorTertiary">@color/md_dark_tertiary</item>
        <item name="colorOnTertiary">@color/md_dark_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_dark_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_dark_on_tertiary_container</item>

        <item name="colorError">@color/md_dark_error</item>
        <item name="colorOnError">@color/md_dark_on_error</item>
        <item name="colorErrorContainer">@color/md_dark_error_container</item>
        <item name="colorOnErrorContainer">@color/md_dark_on_error_container</item>

        <item name="android:colorBackground">@color/md_dark_background</item>
        <item name="colorOnBackground">@color/md_dark_on_background</item>
        <item name="colorSurface">@color/md_dark_surface</item>
        <item name="colorOnSurface">@color/md_dark_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_dark_on_surface_variant</item>
        <item name="colorOutline">@color/md_dark_outline</item>
        <item name="colorOutlineVariant">@color/md_dark_outline_variant</item>

        <item name="android:statusBarColor">@color/md_dark_background</item>
        <item name="android:navigationBarColor">@color/md_dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!-- Tema padrão (usado no manifest antes de ThemeManager aplicar o tema real) -->
    <style name="Theme.ListManager" parent="Theme.ListManager.Light" />

    <!-- Toolbar M3, título/ícones sobre colorSurface -->
    <style name="Widget.ListManager.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Força o FAB principal a ser um círculo perfeito. O FAB padrão do
         Material 3 é um quadrado arredondado; ao girar 45° para virar "X"
         ele vira um losango com pontas, parecendo cortado no canto. -->
    <style name="ShapeAppearanceOverlay.ListManager.FabCircular" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
